# Production stack (`docker compose --env-file .env.docker ...`).
# Copy to `.env.docker` on the server and fill in.

POSTGRES_USER=khzios
POSTGRES_PASSWORD=change-me
POSTGRES_DB=khzios

# Public address of the site
APP_URL=https://khzios.up.poznan.pl

# Host port the app listens on (put a reverse proxy with HTTPS in front)
APP_PORT=3000

# Address of the admin panel: https://<site>/<ADMIN_PATH>. 8–63 lowercase
# letters, digits or hyphens; pick something not guessable, e.g. the output
# of `openssl rand -hex 6` with a prefix: zaplecze-3f9a1c2b7d4e.
# Leave empty to disable the panel.
ADMIN_PATH=
