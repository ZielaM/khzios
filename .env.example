# Local development (`pnpm dev`). Copy to `.env` and fill in.

# PostgreSQL connection string (development database)
DATABASE_URL="postgresql://user:password@host:5432/khzios?sslmode=verify-full"

# Public base URL used for canonical links, the sitemap and share images
APP_URL="http://localhost:3000"

# Admin panel address (defaults to /admin in development)
# ADMIN_PATH="zaplecze-3f9a1c2b7d4e"

# Directory for files uploaded in the panel (defaults to ./uploads)
# UPLOAD_DIR="./uploads"
