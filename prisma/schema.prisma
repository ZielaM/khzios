generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum LanguageCode {
  pl
  en
  uk
  ru
}

model News {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  published Boolean  @default(false)

  tags         Tag[]
  photos       Photo[]
  translations NewsTranslation[]

  @@index([published, createdAt(sort: Desc)])
}

model NewsTranslation {
  newsId       String
  languageCode LanguageCode
  title        String
  content      String

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  // Search vector for full-text search
  searchVector Unsupported("tsvector")?

  @@id([newsId, languageCode])
  // Index for full-text search
  @@index([searchVector])
}

model Tag {
  id           String           @id @default(uuid(7))
  name         String           @unique
  news         News[]
  translations TagTranslation[]
}

model TagTranslation {
  tagId        String
  languageCode LanguageCode
  name         String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, languageCode])
}

model Photo {
  id     String @id @default(uuid(7))
  url    String
  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
}

// ──── Team Models ─────────────────────────────────────────────────────

enum TeamType {
  FULL
  EXTERNAL
}

enum MemberCategory {
  ACADEMIC // Pracownicy naukowo-dydaktyczni
  TECHNICAL // Pracownicy inżynieryjno-techniczni
}

model Team {
  id           String   @id @default(uuid(7))
  slug         String   @unique // Canonical key ("ruminants", "poultry", etc.)
  type         TeamType
  displayOrder Int      @default(0) @db.SmallInt

  translations TeamTranslation[]
  members      TeamMember[]
  publications Publication[]
  projects     ResearchProject[]
  courses      TeachingCourse[]
  links        TeamLink[]
}

model TeamTranslation {
  teamId              String
  languageCode        LanguageCode
  name                String // Team name
  researchDescription String? // Research directions paragraph
  teachingDescription String? // Teaching paragraph

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, languageCode])
}

model TeamLink {
  id           String @id @default(uuid(7))
  teamId       String
  url          String
  icon         String // Icon identifier: "globe", "facebook", "instagram", etc.
  displayOrder Int    @default(0) @db.SmallInt

  team         Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  translations TeamLinkTranslation[]

  @@index([teamId])
}

model TeamLinkTranslation {
  linkId       String
  languageCode LanguageCode
  label        String // e.g. "Visit website", "Facebook"

  link TeamLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, languageCode])
}

// ──── Employee (Centralized Staff Profile) ──────────────────────────────

model Employee {
  id             String  @id @default(uuid(7))
  firstName      String
  lastName       String
  email          String?
  phone          String?
  photoUrl       String?
  profileSlug    String  @unique
  orcid          String? @unique
  officeLocation String?

  translations  EmployeeTranslation[]
  consultations Consultation[]

  teamMembers    TeamMember[]
  departmentHead DepartmentHead?
}

model EmployeeTranslation {
  employeeId    String
  languageCode  LanguageCode
  academicTitle String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, languageCode])
}

model Consultation {
  id         String   @id @default(uuid(7))
  employeeId String
  room       String?
  date       DateTime
  time       String // e.g. "10:00 - 12:00"

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ──── Team Members ────────────────────────────────────────────────────

model TeamMember {
  id         String         @id @default(uuid(7))
  teamId     String
  employeeId String
  category   MemberCategory

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([teamId, employeeId])
  @@index([teamId])
  @@index([employeeId])
}

// ──── Publications ────────────────────────────────────────────────────

model Publication {
  id      String  @id @default(uuid(7))
  teamId  String?
  year    Int     @db.SmallInt
  doi     String? @unique
  authors String // Not translated
  journal String // Not translated

  team         Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  translations PublicationTranslation[]

  @@index([teamId, year(sort: Desc)])
}

model PublicationTranslation {
  publicationId String
  languageCode  LanguageCode
  title         String // Publication title (translated)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  // Search vector for full-text search
  searchVector Unsupported("tsvector")?

  @@id([publicationId, languageCode])
  // Index for full-text search
  @@index([searchVector])
}

// ──── Research Projects ───────────────────────────────────────────────

model ResearchProject {
  id     String @id @default(uuid(7))
  teamId String
  years  String // e.g. "2022–2025"

  team         Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  translations ResearchProjectTranslation[]

  @@index([teamId])
}

model ResearchProjectTranslation {
  projectId    String
  languageCode LanguageCode
  title        String
  funder       String?

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, languageCode])
}

// ──── Teaching Courses ────────────────────────────────────────────────

model TeachingCourse {
  id     String @id @default(uuid(7))
  teamId String

  team         Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  translations TeachingCourseTranslation[]

  @@index([teamId])
}

model TeachingCourseTranslation {
  courseId     String
  languageCode LanguageCode
  name         String // Course name
  program      String // Study program & degree level
  coordinator  String // Course coordinator

  course TeachingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, languageCode])
}

// ──── Department Head ─────────────────────────────────────────────────

model DepartmentHead {
  id         String @id @default(uuid(7))
  employeeId String @unique

  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workingHours DepartmentHeadHour[]
}

model DepartmentHeadHour {
  id           String @id @default(uuid(7))
  headId       String
  displayOrder Int    @default(0) @db.SmallInt

  head         DepartmentHead                  @relation(fields: [headId], references: [id], onDelete: Cascade)
  translations DepartmentHeadHourTranslation[]

  @@index([headId])
}

model DepartmentHeadHourTranslation {
  hourId       String
  languageCode LanguageCode
  day          String
  hours        String

  hour DepartmentHeadHour @relation(fields: [hourId], references: [id], onDelete: Cascade)

  @@id([hourId, languageCode])
}

// ──── Secretariat ─────────────────────────────────────────────────

model Secretariat {
  id             String  @id @default(uuid(7))
  email          String?
  phone          String?
  photoUrl       String?
  officeLocation String?

  translations SecretariatTranslation[]
  workingHours SecretariatHour[]
}

model SecretariatTranslation {
  secretariatId String
  languageCode  LanguageCode
  title         String

  secretariat Secretariat @relation(fields: [secretariatId], references: [id], onDelete: Cascade)

  @@id([secretariatId, languageCode])
}

model SecretariatHour {
  id            String @id @default(uuid(7))
  secretariatId String
  displayOrder  Int    @default(0) @db.SmallInt

  secretariat  Secretariat                  @relation(fields: [secretariatId], references: [id], onDelete: Cascade)
  translations SecretariatHourTranslation[]

  @@index([secretariatId])
}

model SecretariatHourTranslation {
  hourId       String
  languageCode LanguageCode
  day          String
  hours        String

  hour SecretariatHour @relation(fields: [hourId], references: [id], onDelete: Cascade)

  @@id([hourId, languageCode])
}

// ──── Student Announcements ─────────────────────────────────────────────

model StudentAnnouncement {
  id        String   @id @default(uuid(7))
  date      DateTime // Data powiązana z ogłoszeniem
  important Boolean  @default(false)
  createdAt DateTime @default(now())

  translations StudentAnnouncementTranslation[]

  @@index([date(sort: Desc)])
}

model StudentAnnouncementTranslation {
  announcementId String
  languageCode   LanguageCode
  title          String       @db.VarChar(100)
  content        String       @db.VarChar(256)

  announcement StudentAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, languageCode])
}
